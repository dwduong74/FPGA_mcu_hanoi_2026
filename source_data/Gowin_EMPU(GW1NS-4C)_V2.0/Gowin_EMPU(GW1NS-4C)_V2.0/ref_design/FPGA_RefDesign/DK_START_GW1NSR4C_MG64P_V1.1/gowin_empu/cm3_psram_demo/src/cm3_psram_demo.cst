
//DK_START_GW1NSR4C_MG64P V1.1
//GW1NSR-LV4CMG64PC7/I6
//GW1NSR-4C

//system clock
IO_LOC "sys_clk" F5;    //F_CLK
IO_PORT "sys_clk" IO_TYPE=LVCMOS18;

//system reset
IO_LOC "reset_n" F4;    //F_RST_N
IO_PORT "reset_n" IO_TYPE=LVCMOS18;

//LED
IO_LOC "init_calib" A6; //LED1
IO_PORT "init_calib" IO_TYPE=LVCMOS18;

//UART0
IO_LOC "uart0_rxd" D6;  //UART_RXD
IO_LOC "uart0_txd" E6;  //UART_TXD
IO_PORT "uart0_rxd" IO_TYPE=LVCMOS18;
IO_PORT "uart0_txd" IO_TYPE=LVCMOS18;