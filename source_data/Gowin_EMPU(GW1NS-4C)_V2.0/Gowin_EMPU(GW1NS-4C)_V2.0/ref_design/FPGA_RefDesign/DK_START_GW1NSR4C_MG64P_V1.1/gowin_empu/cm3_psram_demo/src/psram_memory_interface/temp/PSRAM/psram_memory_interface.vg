`pragma protect end_protected
module PSRAM_Memory_Interface_Top (
  clk,
  memory_clk,
  pll_lock,
  rst_n,
  O_psram_ck,
  O_psram_ck_n,
  IO_psram_dq,
  IO_psram_rwds,
  O_psram_cs_n,
  O_psram_reset_n,
  wr_data,
  rd_data,
  rd_data_valid,
  addr,
  cmd,
  cmd_en,
  init_calib,
  clk_out,
  data_mask
)
;
input clk;
input memory_clk;
input pll_lock;
input rst_n;
output [1:0] O_psram_ck;
output [1:0] O_psram_ck_n;
inout [15:0] IO_psram_dq;
inout [1:0] IO_psram_rwds;
output [1:0] O_psram_cs_n;
output [1:0] O_psram_reset_n;
input [63:0] wr_data;
output [63:0] rd_data;
output rd_data_valid;
input [20:0] addr;
input cmd;
input cmd_en;
output init_calib;
output clk_out;
input [7:0] data_mask;
wire VCC;
wire GND;
  \~psram_top.PSRAM_Memory_Interface_Top  u_psram_top (
    .memory_clk(memory_clk),
    .rst_n(rst_n),
    .pll_lock(pll_lock),
    .cmd(cmd),
    .cmd_en(cmd_en),
    .clk(clk),
    .wr_data(wr_data[63:0]),
    .addr(addr[20:0]),
    .data_mask(data_mask[7:0]),
    .clk_out(clk_out),
    .rd_data_valid(rd_data_valid),
    .init_calib(init_calib),
    .rd_data(rd_data[63:0]),
    .O_psram_ck(O_psram_ck[1:0]),
    .O_psram_ck_n(O_psram_ck_n[1:0]),
    .O_psram_cs_n(O_psram_cs_n[1:0]),
    .O_psram_reset_n(O_psram_reset_n[0]),
    .IO_psram_dq(IO_psram_dq[15:0]),
    .IO_psram_rwds(IO_psram_rwds[1:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
  GSR GSR (
    .GSRI(VCC) 
);
assign O_psram_reset_n[1] = O_psram_reset_n[0];
endmodule /* PSRAM_Memory_Interface_Top */
