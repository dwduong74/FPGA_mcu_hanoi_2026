module HyperRAM_Memory_Interface_Top (
  clk,
  memory_clk,
  pll_lock,
  rst_n,
  O_hpram_ck,
  O_hpram_ck_n,
  IO_hpram_dq,
  IO_hpram_rwds,
  O_hpram_cs_n,
  O_hpram_reset_n,
  wr_data,
  rd_data,
  rd_data_valid,
  addr,
  cmd,
  cmd_en,
  init_calib,
  clk_out,
  data_mask
)
;
input clk;
input memory_clk;
input pll_lock;
input rst_n;
output [0:0] O_hpram_ck;
output [0:0] O_hpram_ck_n;
inout [7:0] IO_hpram_dq;
inout [0:0] IO_hpram_rwds;
output [0:0] O_hpram_cs_n;
output [0:0] O_hpram_reset_n;
input [31:0] wr_data;
output [31:0] rd_data;
output rd_data_valid;
input [21:0] addr;
input cmd;
input cmd_en;
output init_calib;
output clk_out;
input [3:0] data_mask;
wire VCC;
wire GND;
