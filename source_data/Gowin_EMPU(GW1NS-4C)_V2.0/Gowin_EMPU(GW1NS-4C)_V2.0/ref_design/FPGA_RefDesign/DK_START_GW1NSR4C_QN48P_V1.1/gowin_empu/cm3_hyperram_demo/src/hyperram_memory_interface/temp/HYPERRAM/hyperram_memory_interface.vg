    .memory_clk(memory_clk),
    .rst_n(rst_n),
    .pll_lock(pll_lock),
    .cmd_en(cmd_en),
    .cmd(cmd),
    .clk(clk),
    .wr_data(wr_data[31:0]),
    .addr(addr[21:0]),
    .data_mask(data_mask[3:0]),
    .clk_out(clk_out),
    .rd_data_valid(rd_data_valid),
    .init_calib(init_calib),
    .rd_data(rd_data[31:0]),
    .O_hpram_ck(O_hpram_ck[0]),
    .O_hpram_ck_n(O_hpram_ck_n[0]),
    .O_hpram_cs_n(O_hpram_cs_n[0]),
    .O_hpram_reset_n(O_hpram_reset_n[0]),
    .IO_hpram_dq(IO_hpram_dq[7:0]),
    .IO_hpram_rwds(IO_hpram_rwds[0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
  GSR GSR (
    .GSRI(VCC) 
);
endmodule /* HyperRAM_Memory_Interface_Top */
