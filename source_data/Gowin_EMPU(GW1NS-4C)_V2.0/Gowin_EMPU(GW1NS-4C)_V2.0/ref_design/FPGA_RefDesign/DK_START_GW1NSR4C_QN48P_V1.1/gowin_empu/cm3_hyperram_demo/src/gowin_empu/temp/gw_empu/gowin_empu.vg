    .master_hexreq(master_hexreq),
    .master_hmastlock(master_hmastlock),
    .master_hreadymux(master_hreadymux),
    .master_hauser(master_hauser),
    .master_haddr(master_haddr[31:0]),
    .master_htrans(master_htrans[1:0]),
    .master_hsize(master_hsize[2:0]),
    .master_hburst(master_hburst[2:0]),
    .master_hprot(master_hprot[3:0]),
    .master_hmemattr(master_hmemattr[1:0]),
    .master_hmaster(master_hmaster[3:0]),
    .master_hwdata(master_hwdata[31:0]),
    .master_hwuser(master_hwuser[3:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
assign master_hclk = sys_clk;
endmodule /* Gowin_EMPU_Top */
