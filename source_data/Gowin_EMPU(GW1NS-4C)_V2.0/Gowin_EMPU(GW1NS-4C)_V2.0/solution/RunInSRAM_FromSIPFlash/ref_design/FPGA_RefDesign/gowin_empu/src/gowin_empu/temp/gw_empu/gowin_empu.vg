`pragma protect end_protected
module Gowin_EMPU_Top (
  sys_clk,
  uart0_rxd,
  uart0_txd,
  master_pclk,
  master_prst,
  master_penable,
  master_paddr,
  master_pwrite,
  master_pwdata,
  master_pstrb,
  master_pprot,
  master_psel1,
  master_prdata1,
  master_pready1,
  master_pslverr1,
  reset_n
)
;
input sys_clk;
input uart0_rxd;
output uart0_txd;
output master_pclk;
output master_prst;
output master_penable;
output [7:0] master_paddr;
output master_pwrite;
output [31:0] master_pwdata;
output [3:0] master_pstrb;
output [2:0] master_pprot;
output master_psel1;
input [31:0] master_prdata1;
input master_pready1;
input master_pslverr1;
input reset_n;
wire VCC;
wire GND;
  \~Gowin_EMPU.Gowin_EMPU_Top  Gowin_EMPU_inst (
    .reset_n(reset_n),
    .sys_clk(sys_clk),
    .uart0_rxd(uart0_rxd),
    .master_pready1(master_pready1),
    .master_pslverr1(master_pslverr1),
    .master_prdata1(master_prdata1[31:0]),
    .uart0_txd(uart0_txd),
    .master_penable(master_penable),
    .master_pwrite(master_pwrite),
    .master_psel1(master_psel1),
    .master_pstrb(master_pstrb[3:0]),
    .master_pprot(master_pprot[2:0]),
    .master_paddr(master_paddr[7:0]),
    .master_pwdata(master_pwdata[31:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
assign master_pclk = sys_clk;
assign master_prst = reset_n;
endmodule /* Gowin_EMPU_Top */
