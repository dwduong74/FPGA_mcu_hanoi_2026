 119          Function:   W25Q Read Data
 120          input:      None
 121          Output:     None
 122          Return:     None
 123          ****************************************************************************************/
 124          void w25q_read_data(uint32_t lReadAddr, uint8_t * p_cBuffer, uint16_t iNumByteToRead)
 125          {     
 126   1        while(w25q_busy());                           // Wait Bus Idle  
 127   1        
 128   1        O_IO_CS = 0;                                  // Enable Slave
 129   1          
 130   1        spi_WtRd_Byte(W25Q_READ_DATA);                // Send Read Instruction
 131   1        
 132   1        spi_WtRd_Byte((uint8_t) (lReadAddr >> 16));   // Send Read Address (8 Bytes)
 133   1        spi_WtRd_Byte((uint8_t) (lReadAddr >> 8));
 134   1        spi_WtRd_Byte((uint8_t) lReadAddr);
 135   1      
 136   1        while(iNumByteToRead--)
 137   1        {
 138   2          *p_cBuffer++ = spi_WtRd_Byte(0xFF);         // Read Data
 139   2        }
 140   1        
 141   1        O_IO_CS = 1;                                  // Disable Slave
 142   1      }
