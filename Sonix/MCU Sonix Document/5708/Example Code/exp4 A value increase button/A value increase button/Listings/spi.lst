 148          ****************************************************************************************/
 149          void w25q_write_256bytes(uint32_t lWriteAddr, uint8_t * p_cBuffer, uint16_t iNumByteToWrite)
 150          {
 151   1        uint16_t iSectAdr;
 152   1        
 153   1        iSectAdr = lWriteAddr / 4096;                   // 128(block) * 16(sector) = 2048(sector)  4KB(Each sector) = 4 * 
             -1024 = 4096 (Byte)
 154   1        w25q_erase_sector(iSectAdr);                    // Erase Sector
 155   1        
 156   1        while(w25q_busy());                             // Wait Bus Idle    
 157   1        
 158   1        w25q_write_enable();                            // Send Write Enable Instruction
 159   1      
 160   1        O_IO_CS = 0;                                    // Enable Slave
 161   1        
 162   1        spi_WtRd_Byte(W25Q_PAGE_PROGRAM);               // Send Page Program Instruction
 163   1        
 164   1        spi_WtRd_Byte((uint8_t) ((lWriteAddr) >> 16));  // Send Write Address (8 Bytes)
 165   1        spi_WtRd_Byte((uint8_t) ((lWriteAddr) >> 8));
 166   1        spi_WtRd_Byte((uint8_t) lWriteAddr);
 167   1      
 168   1        while(iNumByteToWrite--)
 169   1        {
 170   2          spi_WtRd_Byte(*p_cBuffer++);                  // Send Data
 171   2        }
 172   1        
 173   1        while(w25q_busy());                             // Wait Bus Idle  
 174   1        
 175   1        O_IO_CS = 1;                                    // Disable Slave
