  54          bit w25q_busy(void)
  55          {
  56   1        uint8_t cTemp;
  57   1                      
  58   1        O_IO_CS = 0;                                // Enable Slave
  59   1      
  60   1        spi_WtRd_Byte(W25Q_READ_STATUS1);           // Read Status Register Instruction
  61   1        
  62   1        cTemp = spi_WtRd_Byte(0xFF);                // Read Status  
  63   1        
  64   1        O_IO_CS = 1;                                // Disable Slave
  65   1        
  66   1        return (cTemp & 0x01) ;
  67   1      }
