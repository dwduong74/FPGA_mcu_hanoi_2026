 179          /****************************************************************************************
 180          Function:   Read W25Q ID 
 181          input:      None
 182          Output:     None
 183          Return:     None
 184          ****************************************************************************************/
 185          //0XEF13,表示芯片型号为W25Q80
 186          //0XEF14,表示芯片型号为W25Q16
 187          //0XEF15,表示芯片型号为W25Q32
 188          //0XEF16,表示芯片型号为W25Q64
 189          //0XEF17,表示芯片型号为W25Q128
 190          void w25q_read_id (void)
 191          {
 192   1        static uint16_t g_iId;
 193   1        
 194   1        while(w25q_busy());                             // Wait Bus Idle  
 195   1        
 196   1        O_IO_CS = 0;                                    // Enable Slave
 197   1        
 198   1        spi_WtRd_Byte(0x90);                
 199   1        spi_WtRd_Byte(0x00);
 200   1        spi_WtRd_Byte(0x00);
 201   1        spi_WtRd_Byte(0x00);                            // Send Read Device ID Instruction
 202   1        
 203   1        g_iId = 0;
 204   1        g_iId |= spi_WtRd_Byte(0xFF) << 8;              // Read ID
 205   1        g_iId |= spi_WtRd_Byte(0xFF);
 206   1        
 207   1        O_IO_CS = 1;                                    // Disable Slave
 208   1      }


