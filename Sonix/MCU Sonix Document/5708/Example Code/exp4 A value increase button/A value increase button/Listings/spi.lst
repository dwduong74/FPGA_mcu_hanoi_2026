  97          Function:   W25Q Erase Sector
  98          input:      None
  99          Output:     None
 100          Return:     None
 101          ****************************************************************************************/
 102          void w25q_erase_sector(uint16_t iAddr)
 103          {
 104   1        while(w25q_busy());                           // Wait Bus Idle    
 105   1        
 106   1        w25q_write_enable();                          // Send Write Enable Instruction  
 107   1        
 108   1        O_IO_CS = 0;                                  // Enable Slave
 109   1        
 110   1        spi_WtRd_Byte(W25Q_SECTOR_ERASE);             // Send Erase Sector Enable Instruction 
 111   1        
 112   1        spi_WtRd_Byte((uint8_t) ((iAddr) >> 16));     // Send Address
 113   1        spi_WtRd_Byte((uint8_t) ((iAddr) >> 8));
 114   1        spi_WtRd_Byte((uint8_t) iAddr);
