  12          **Description     :Configure UART0 MODE 1 9600 baud rate and io
  13          ***********************************************************/
  14          void uart0_config(void)
  15          { 
  16   1      
  17   1        P05 = 1;
  18   1        P0M |= 0x20;                                  
  19   1        P0M &= 0xbf;          //            
  20   1        S0CON = 0X40 | 0X10; //enabel uart and Configure mode 1
  21   1      
  22   1        PCON &= 0x7f;                                 
  23   1        S0CON2 |= 0X80;    //
  24   1        S0RELH = 0x03;
  25   1        S0RELL = 0xF3;     // 9600
  26   1                                                      
  27   1        ES0 = 1;          //enable uart interrupt
  28   1        EAL = 1;          //enable  General interrupt
  29   1      }
