  55          /***********************************************************
  56          **Function name   :segment_display(uint16_t tempdata)
  57          **
  58          **Input parameter : uint16_t tempdata
  59          **
  60          **Input parameter : null
  61          **
  62          **Description     :Displays a number less than 9999 on the nixie tube
  63          ***********************************************************/
  64          void segment_display(uint16_t tempdata)
  65          {
  66   1        if(tempdata > 9999){
  67   2          led_buff[0] = 0x40;
  68   2          led_buff[1] = 0x40;
  69   2          led_buff[2] = 0x40;
  70   2          led_buff[3] = 0x40;   //数据太大 显示 "----"
  71   2        }else{
  72   2          led_buff[3] = numble_tab[tempdata%10];
  73   2          tempdata /= 10;
  74   2          led_buff[2] = numble_tab[tempdata%10];
  75   2          tempdata /= 10;
  76   2          led_buff[1] = numble_tab[tempdata%10];
  77   2          tempdata /= 10;    
  78   2          led_buff[0] = numble_tab[tempdata];
  79   2        } 
  80   1      }
  81          /***********************************************************
  82          **Function name   :segment_displayhex(uint16_t tempdata)
  83          **
