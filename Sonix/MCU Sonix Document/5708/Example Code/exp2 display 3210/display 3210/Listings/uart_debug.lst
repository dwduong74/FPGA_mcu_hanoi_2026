  59          /***********************************************************
  60          **函数名     :char putchar(char ch)
  61          **功能描述   :软件实现UART TX功能  FCPU = 8M  FROM = 8M 波特率 115200   TX = DEBUG_TX    #define  DEBUG_TX
             -  定义
  62          **
  63          **输入参数   : 汇编实现 适用于不同编译器  FCPU = 8M  FROM = 8M 其他参数需要重新设置延时时间DELAYCNT
  64          **
  65          **返回参数   :printf 输出重定向到uart  DEBUG时可用printf
  66          **
  67          **使用说明   :
  68          ***********************************************************/
  69          
  70          char putchar(char ch)
  71          { 
  72   1        #pragma asm
  73   1        MOV   C,EAL
  74   1        MOV   EAL_BIT,C
  75   1        CLR   EAL
  76   1      start:
  77   1        CLR   DEBUG_TX
  78   1        NOP
  79   1        #if DELAYCNT
  80   1        MOV   delay_cnt,#(DELAYCNT)
  81   1        DJNZ  delay_cnt,$
  82   1        #endif
  83   1        MOV   A,#8
  84   1        MOV   R4,A
  85   1      send_byte:
  86   1        MOV   A,R7
  87   1        RRC   A
  88   1        MOV   DEBUG_TX,C
  89   1        MOV   R7,A
  90   1        #if DELAYCNT
  91   1        MOV   delay_cnt,#(DELAYCNT)
  92   1        DJNZ  delay_cnt,$
  93   1        #endif
  94   1        DJNZ  R4,send_byte
  95   1      stop:  
  96   1        NOP
  97   1        NOP
  98   1        SETB  DEBUG_TX
  99   1        MOV   delay_cnt,#(DELAYCNT)
 100   1        DJNZ  delay_cnt,$  
 101   1        MOV   C,EAL_BIT
 102   1        MOV   EAL,C
 103   1        #pragma endasm 
 104   1        
 105   1        return ch;    
 106   1      }


